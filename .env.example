# X UP Data — copy to .env for local runs; in production set these in Railway → Variables.
# Never commit real values.

# Secret that protects the connector. Generate with: openssl rand -hex 32
ACCESS_KEY=

# Dev Dashboard app "X UP Data (read-only)", installed on every store (client credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The stores to read. "token" is optional: only for a store that has its own Admin API token.
STORES=[{"id":"rtzn","name":"RTZN","shop":"your-store.myshopify.com"}]

# Optional: also read every installed brand (and its token) from the xup-reports database
REPORTS_DATABASE_URL=

# Optional
SHOPIFY_API_VERSION=2026-10
RATE_LIMIT_PER_MINUTE=240
# MOCK=1 serves made-up data, no credentials needed
